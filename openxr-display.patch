+#ifdef XR_USE_PLATFORM_ANDROID
+    bool m_cinemaRefreshEnabled = false;
+    float m_cinemaLastRequest = 0;
+    PFN_xrEnumerateDisplayRefreshRatesFB m_cinemaEnumerateHz = nullptr;
+    PFN_xrRequestDisplayRefreshRateFB m_cinemaRequestHz = nullptr;
+    PFN_xrGetDisplayRefreshRateFB m_cinemaGetHz = nullptr;
+
+    void UpdateCinemaRefresh() {
+        if (!m_cinemaRefreshEnabled) return;
+        const float requested = (Cinema::config & (1 << 21)) ? 90.f : 72.f;
+        if (m_sessionState == XR_SESSION_STATE_FOCUSED && requested != m_cinemaLastRequest) {
+            m_cinemaLastRequest = requested;
+            uint32_t count = 0;
+            if (XR_SUCCEEDED(m_cinemaEnumerateHz(m_session, 0, &count, nullptr)) && count) {
+                std::vector<float> rates(count);
+                if (XR_SUCCEEDED(m_cinemaEnumerateHz(m_session, count, &count, rates.data()))) {
+                    for (float rate : rates) {
+                        if (std::abs(rate - requested) >= .5f) continue;
+                        const XrResult result = m_cinemaRequestHz(m_session, rate);
+                        Log::Write(XR_SUCCEEDED(result) ? Log::Level::Info : Log::Level::Warning,
+                            Fmt("Aniart display request %.0f Hz: %d", rate, int(result)));
+                        break;
+                    }
+                }
+            }
+        }
+        if (!Cinema::displayHz || Cinema::renderFrame % 72 == 0) {
+            m_cinemaGetHz(m_session, &Cinema::displayHz);
+        }
+    }
+#endif
